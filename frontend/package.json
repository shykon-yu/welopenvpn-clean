{
  "name": "wel-openvpn-client",
  "private": true,
  "version": "0.1.65",
  "packageManager": "pnpm@11.11.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "test:electron": "node --test electron/network.test.cjs electron/firewall.test.cjs electron/installer.test.cjs electron/openvpn.test.cjs",
    "electron:dev": "npm run build && electron electron/main.cjs",
    "electron:build": "npm run build && electron-builder --win nsis",
    "electron": "electron"
  },
  "dependencies": {
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.2.8",
    "vue": "^3.5.13"
  },
  "build": {
    "appId": "com.wel.openvpn.client",
    "productName": "WEL职业联盟对战平台",
    "artifactName": "WEL职业联盟对战平台-${version}-安装包.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/*.test.cjs"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/openvpn",
        "to": "openvpn",
        "filter": [
          "**/*",
          "!README.md"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "WEL职业联盟对战平台",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "WEL职业联盟对战平台 v0.1.65",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vue-tsc": "^2.2.0"
  }
}
