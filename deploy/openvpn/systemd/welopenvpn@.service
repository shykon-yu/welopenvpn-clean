[Unit]
Description=WEL OpenVPN TAP room %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/welopenvpn/welopenvpn.env
Environment=WEL_ROOM_ID=%i
ExecStartPre=/usr/bin/mkdir -p /run/welopenvpn/ccd/room-%i
ExecStart=/usr/sbin/openvpn --config /etc/welopenvpn/rooms/room-%i.conf
Restart=on-failure
RestartSec=3
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
